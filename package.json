{
  "name": "bakers-24-proposal",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Concept proposal website for Baker's 24, a pure-veg cake shop in Pimpri, Pune. Not a live storefront.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "build:internal": "INTERNAL_PAGES=1 ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=chromium-mobile --project=webkit-mobile --project=chromium-desktop",
    "test:all": "npm run check && npm run test && npm run build && npm run test:e2e",
    "ref:crop": "node scripts/reference/crop-panels.mjs",
    "ref:colors": "node scripts/reference/sample-colors.mjs",
    "ref:fonts": "node scripts/reference/font-match.mjs",
    "ref:compare": "node scripts/reference/compare.mjs",
    "shots": "playwright test --project=screenshots"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/libre-bodoni": "5.3.0",
    "astro": "7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@fontsource-variable/bodoni-moda": "5.3.0",
    "@fontsource-variable/cormorant-garamond": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/noto-serif-display": "5.3.0",
    "@fontsource-variable/playfair": "5.3.0",
    "@fontsource-variable/playfair-display": "5.3.0",
    "@fontsource/dm-serif-display": "5.3.0",
    "@fontsource/gilda-display": "5.3.0",
    "@fontsource/libre-caslon-display": "5.3.0",
    "@fontsource/prata": "5.3.0",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.0",
    "playwright-core": "1.63.0",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  }
}
