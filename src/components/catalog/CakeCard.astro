---
// Horizontal editorial cake card from the approved mobile catalog reference: image (or text-only
// panel) on the left, name and historical price on the right, on the clay card surface.
//   regular    one of the 23 catalog cakes; the whole card is a single link to /cakes/<slug>/,
//              named by the cake's name only (no nested controls inside the link)
//   custom     a past custom-cake example (not linked; there are no custom detail pages)
//   seasonal   a past seasonal record (not linked; there are no seasonal detail pages)
// Names, weights and prices come from CATALOG.json (via products.ts for regular cakes), price
// qualifiers from PriceNote. No descriptions, ratings, badges, favourites or ordering controls.
//
// Colours: every text colour on the clay surface is cream (5.04:1); the sand and taupe tokens
// fail AA there. The card stacks (image above text) when it is narrower than 20rem, which also
// happens when text is enlarged, because the threshold is in rem.

import { Image } from "astro:assets";
import PriceNote from "./PriceNote.astro";
import { productCake, productImage, type ProductEntry } from "../../data/products";
import { photographPending } from "../../data/notices";
import type { CustomExample, SeasonalExample } from "../../data/schema";

type Props = {
  /** Heading level of the cake name: 2 in a page's list, 3 if the list sits under its own h2. */
  headingLevel?: 2 | 3;
  /** Load the image eagerly (only the first card above the fold). */
  eager?: boolean;
  class?: string;
} & (
  | { kind: "regular"; product: ProductEntry }
  | { kind: "custom"; record: CustomExample; note?: string }
  | { kind: "seasonal"; record: SeasonalExample; note?: string }
);

const props = Astro.props;
const { headingLevel = 2, eager = false, class: className } = props;
const Heading = `h${headingLevel}` as "h2" | "h3";

const record = props.kind === "regular" ? productCake(props.product) : props.record;
const image = props.kind === "regular" ? productImage(props.product) : undefined;
const href = props.kind === "regular" ? `/cakes/${props.product.slug}/` : undefined;
const note = props.kind === "regular" ? undefined : props.note;
const id = props.kind === "regular" ? props.product.id : props.record.id;
const titleId = `${id}-name`; // catalog ids are unique across cakes, custom and seasonal records
const Root = href ? "a" : "div";
// “Hazelnut/Nutella Truffle” has no line-break opportunity at the slash; <wbr> adds one without
// changing the text, so enlarged text breaks there instead of mid-word.
const nameParts = record.name.split("/");
---

<div class:list={["cake-card", className]} data-image-kind={image ? image.kind : "none"}>
  <Root class="cake-card__inner" href={href} aria-labelledby={href ? titleId : undefined}>
    {
      image ? (
        <figure class="cake-card__media">
          <Image
            src={image.src}
            alt={image.alt}
            widths={[image.src.width]}
            sizes="(min-width: 48rem) 12rem, 42vw"
            loading={eager ? "eager" : "lazy"}
            decoding="async"
            class="cake-card__img"
          />
          <figcaption class="cake-card__label">{image.label}</figcaption>
        </figure>
      ) : (
        <div class="cake-card__media cake-card__media--pending">
          <svg class="cake-card__mark" viewBox="0 0 40 40" width="28" height="28" aria-hidden="true" focusable="false">
            <path d="M20 1.5c3.6 5 4.6 10.4 0 16.3-4.6-5.9-3.6-11.3 0-16.3Z" />
            <path d="M20 38.5c-3.6-5-4.6-10.4 0-16.3 4.6 5.9 3.6 11.3 0 16.3Z" />
            <path d="M1.5 20c5-3.6 10.4-4.6 16.3 0-5.9 4.6-11.3 3.6-16.3 0Z" />
            <path d="M38.5 20c-5 3.6-10.4 4.6-16.3 0 5.9-4.6 11.3-3.6 16.3 0Z" />
            <path d="m20 17.2 2.8 2.8-2.8 2.8-2.8-2.8Z" />
          </svg>
          <span class="cake-card__pending">{photographPending}</span>
        </div>
      )
    }
    <div class="cake-card__body">
      <Heading id={titleId} class="cake-card__name t-card-title">
        {nameParts.map((part, i) => (i > 0 ? <Fragment>/<wbr />{part}</Fragment> : part))}
      </Heading>
      {
        props.kind === "regular" ? (
          <PriceNote kind="regular" record={productCake(props.product)} class="cake-card__price" />
        ) : props.kind === "custom" ? (
          <PriceNote kind="custom" record={props.record} class="cake-card__price" />
        ) : (
          <PriceNote kind="seasonal" record={props.record} class="cake-card__price" />
        )
      }
      {note && <p class="cake-card__note">{note}</p>}
    </div>
  </Root>
</div>

<style>
  .cake-card {
    container-type: inline-size;
  }

  .cake-card__inner {
    display: grid;
    grid-template-columns: minmax(7.5rem, 42%) minmax(0, 1fr);
    align-items: stretch;
    gap: var(--space-4);
    min-height: 7.5rem;
    padding: 0.625rem;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-lg);
    background: var(--color-surface-card);
    box-shadow: var(--shadow-card);
    color: var(--color-text);
    text-decoration: none;
    transition: border-color var(--duration-base) var(--ease-out);
    -webkit-tap-highlight-color: transparent;
  }

  /* The ring sits outside the card, on the dark catalog background: cream, not rose-gold. */
  a.cake-card__inner:focus-visible {
    outline: 2px solid var(--color-focus-on-card);
    outline-offset: 3px;
  }

  a.cake-card__inner:hover {
    border-color: color-mix(in srgb, var(--palette-cream-100) 45%, transparent);
  }

  /* Image or text-only panel: 6:5, rounded, never taller than the card needs. */
  .cake-card__media {
    position: relative;
    align-self: start;
    width: 100%;
    margin: 0;
    aspect-ratio: 6 / 5;
    overflow: hidden;
    border-radius: var(--radius-md);
  }

  .cake-card :global(.cake-card__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cake-card__label {
    position: absolute;
    left: 0.375rem;
    bottom: 0.375rem;
    max-width: calc(100% - 0.75rem);
    padding: 0.125rem 0.5rem;
    border-radius: var(--radius-pill);
    background: var(--color-bg);
    color: var(--color-text);
    font-size: 0.6875rem;
    font-weight: var(--weight-ui);
    line-height: 1.35;
    letter-spacing: 0.02em;
  }

  .cake-card__media--pending {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-2);
    background: var(--color-surface-cocoa-deep);
    text-align: center;
  }

  .cake-card__mark {
    flex: none;
    fill: var(--palette-champagne-300);
  }

  .cake-card__pending {
    font-size: 0.75rem;
    line-height: 1.3;
    color: var(--color-text-soft);
  }

  .cake-card__body {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-2);
    min-width: 0;
    padding-block: var(--space-1);
  }

  .cake-card__name {
    color: var(--color-text);
    overflow-wrap: break-word;
    hyphens: manual;
  }

  .cake-card__note {
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--color-text);
  }

  /* Narrow (and enlarged-text) layout: image above the text. 20rem keeps the reference’s
     horizontal card at 375–430px phones (card 335–387px) and stacks at 320px. */
  @container (max-width: 20rem) {
    .cake-card__inner {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* Wider screens: the image column settles at 12rem; no new desktop art direction. */
  @container (min-width: 36rem) {
    .cake-card__inner {
      grid-template-columns: 12rem minmax(0, 1fr);
    }
  }
</style>
