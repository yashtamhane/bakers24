---
// Introduction at the top of a catalog page: optional illustrative header image, eyebrow, the
// page title (the page's single <h1> by default) and the approved notice(s) beneath it.
// Notice wording is passed in from src/data/notices.ts; this component adds no copy of its own.
//
// The header image, when present, is concept artwork, so it always carries a visible
// “Illustrative image” label (approved M3 wording), whatever label its registry entry uses.

import { Image } from "astro:assets";
import type { ManagedImage } from "../../data/images";
import { illustrativeImageNotice } from "../../data/notices";

interface Props {
  eyebrow: string;
  title: string;
  /** Approved price/availability notice for the page (from notices.ts). */
  notice: string;
  /** Also explain the “Illustrative image” label (pages that show illustrative imagery). */
  imageNotice?: boolean;
  /** Optional illustrative header image (registered in images.ts). */
  image?: ManagedImage;
  /** Heading level of the title; 1 unless the page already has an <h1>. */
  headingLevel?: 1 | 2;
  /** Id for the title, so a section can be labelled by it. */
  titleId?: string;
}

const { eyebrow, title, notice, imageNotice = false, image, headingLevel = 1, titleId } = Astro.props;
const Heading = `h${headingLevel}` as "h1" | "h2";
const showIllustrativeLabel = image !== undefined && image.kind !== "portfolio";
---

<div class="catalog-intro">
  {
    image && (
      <figure class="catalog-intro__media" data-image-kind={image.kind}>
        <Image
          src={image.src}
          alt={image.alt}
          widths={[image.src.width]}
          sizes="(max-width: 44rem) 100vw, 44rem"
          loading="eager"
          decoding="async"
          class="catalog-intro__img"
        />
        {showIllustrativeLabel && <figcaption class="catalog-intro__label">Illustrative image</figcaption>}
      </figure>
    )
  }
  <p class="t-eyebrow catalog-intro__eyebrow">{eyebrow}</p>
  <Heading id={titleId} class="t-title catalog-intro__title">{title}</Heading>
  <p class="catalog-intro__notice">{notice}</p>
  {(imageNotice || showIllustrativeLabel) && <p class="catalog-intro__notice">{illustrativeImageNotice}</p>}
</div>

<style>
  .catalog-intro {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    color: var(--color-text);
  }

  /* Short 16:9 header image with the reference's soft rounding. */
  .catalog-intro__media {
    position: relative;
    width: 100%;
    margin: 0 0 var(--space-6);
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--color-surface-cocoa-deep);
  }

  .catalog-intro :global(.catalog-intro__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .catalog-intro__label {
    position: absolute;
    left: var(--space-3);
    bottom: var(--space-3);
    padding: 0.125rem 0.5rem;
    border-radius: var(--radius-pill);
    background: var(--color-bg);
    color: var(--color-text);
    font-size: 0.6875rem;
    font-weight: var(--weight-ui);
    letter-spacing: 0.02em;
  }

  .catalog-intro__title {
    margin-top: var(--space-2);
    max-width: 100%;
    overflow-wrap: break-word;
    hyphens: manual;
  }

  .catalog-intro__notice {
    max-width: var(--measure);
    margin-top: var(--space-3);
    font-size: var(--text-small);
    line-height: 1.5;
    color: var(--color-text-soft);
  }

  .catalog-intro__notice + .catalog-intro__notice {
    margin-top: var(--space-2);
  }
</style>
