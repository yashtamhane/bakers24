---
// Search and category filter for the /cakes/ list (M3 Stage 6). It filters the cards already on
// the page (see catalog-filter.ts) and adds no cake of its own.
//   - Search: a labelled search field matching cake names.
//   - Category: All plus the audited collections from collections.ts (approved decision D7), as
//     the design system's single-select chips. A cake can be in several collections or none.
//   - A polite status line with the result count, a Reset button, and an empty state.
// Without JavaScript the controls are hidden (see the <noscript> rule on the page) and all 23
// cards stay visible, so nothing on the page is inert.
//
// Membership is serialised by list-item id, which CakeList gives each card ("cake-item-<slug>").

import Chip from "../ui/Chip.astro";
import ChipGroup from "../ui/ChipGroup.astro";
import Icon from "../ui/Icon.astro";
import { collections } from "../../data/collections";
import { productCollections, type ProductEntry } from "../../data/products";

interface Props {
  /** The products listed on the page, in list order. */
  products: readonly ProductEntry[];
  /** CSS selector of the list whose items are filtered. */
  list: string;
}

const { products, list } = Astro.props;
const memberships = Object.fromEntries(
  products.map((product) => [`cake-item-${product.slug}`, productCollections(product).map((c) => c.id)]),
);
---

<div class="catalog-filter" data-catalog-filter data-list={list} data-memberships={JSON.stringify(memberships)}>
  <form class="catalog-filter__form" role="search" aria-label="Filter cakes">
    <div class="catalog-filter__field">
      <label class="catalog-filter__label" for="cake-search">Search by cake name</label>
      <div class="catalog-filter__search">
        <Icon name="search" size={20} class="catalog-filter__search-icon" />
        <input
          class="catalog-filter__input"
          id="cake-search"
          type="search"
          name="q"
          autocomplete="off"
          autocapitalize="none"
          spellcheck="false"
          enterkeyhint="search"
        />
      </div>
    </div>

    <div class="catalog-filter__field">
      <span class="catalog-filter__label" aria-hidden="true">Category</span>
      <ChipGroup label="Category">
        <Chip label="All" value="all" pressed />
        {collections.map((c) => <Chip label={c.label} value={c.id} />)}
      </ChipGroup>
    </div>

    <div class="catalog-filter__summary">
      <p class="catalog-filter__status" role="status" aria-atomic="true" data-filter-status>
        Showing all {products.length} cakes
      </p>
      <button class="catalog-filter__reset" type="button" data-filter-reset>Reset filters</button>
    </div>
  </form>

  <div class="catalog-filter__empty" hidden data-filter-empty>
    <p class="catalog-filter__empty-title" data-filter-empty-text>No cakes in the catalogue match these filters.</p>
    <p class="catalog-filter__empty-hint">Try a different name or category, or clear the filters to see all {products.length} cakes.</p>
    <button class="catalog-filter__clear" type="button" data-filter-clear>Clear filters</button>
  </div>
</div>

<script>
  import { initCatalogFilter } from "./catalog-filter";

  for (const root of document.querySelectorAll<HTMLElement>("[data-catalog-filter]")) initCatalogFilter(root);
</script>

<style>
  .catalog-filter {
    container-type: inline-size;
  }

  .catalog-filter__form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .catalog-filter__field {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    min-width: 0;
  }

  .catalog-filter__label {
    font-size: var(--text-small);
    font-weight: var(--weight-ui);
    line-height: 1.35;
    color: var(--color-text-soft);
  }

  /* Search field: the chip surface and 3:1 clay border, as a pill. */
  .catalog-filter__search {
    position: relative;
  }

  .catalog-filter :global(.catalog-filter__search-icon) {
    position: absolute;
    top: 50%;
    left: var(--space-4);
    translate: 0 -50%;
    color: var(--color-text-soft);
    pointer-events: none;
  }

  .catalog-filter__input {
    width: 100%;
    min-height: var(--tap-min);
    padding: var(--space-2) var(--space-4) var(--space-2) calc(var(--space-4) + 1.25rem + var(--space-3));
    border: 1px solid var(--color-chip-border);
    border-radius: var(--radius-pill);
    background: var(--color-chip-bg);
    color: var(--color-text);
    font-size: 1rem; /* 16px: no zoom-on-focus on iOS */
    line-height: 1.35;
    appearance: none;
  }

  /* The native clear button is near-invisible on the dark field; Esc and Reset clear instead. */
  .catalog-filter__input::-webkit-search-cancel-button {
    appearance: none;
  }

  .catalog-filter__summary {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0 var(--space-4);
  }

  .catalog-filter__status {
    font-size: var(--text-small);
    line-height: 1.35;
    color: var(--color-text-soft);
  }

  .catalog-filter__reset,
  .catalog-filter__clear {
    min-height: var(--tap-min);
    font-size: var(--text-small);
    font-weight: var(--weight-ui);
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  /* Wider tap area without moving the text: the padding is cancelled by negative margins. */
  .catalog-filter__reset {
    margin-inline: calc(var(--space-2) * -1);
    padding-inline: var(--space-2);
  }

  .catalog-filter__empty {
    margin-top: var(--space-6);
    padding: var(--space-5);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-lg);
    background: var(--color-surface-cocoa-deep);
  }

  .catalog-filter__empty-title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    line-height: 1.3;
    color: var(--color-text);
    overflow-wrap: break-word;
  }

  .catalog-filter__empty-hint {
    margin-top: var(--space-2);
    font-size: var(--text-small);
    line-height: 1.5;
    color: var(--color-text-soft);
  }

  .catalog-filter__clear {
    margin-top: var(--space-2);
  }

  /* Selecting a chip swaps its text and fill together, at once: every in-between fill on the way
     from cocoa to blush is too mid-toned for either cream or wine text to reach 4.5:1. Only the
     border keeps the chip's eased transition (and its hover change); reduced motion still removes it. */
  .catalog-filter :global(.chip) {
    transition: border-color var(--duration-base) var(--ease-out);
  }

  /* Enlarged text (a filter under 16rem wide; 17.5rem at 320px with normal text): the chips
     wrap onto several rows instead of scrolling sideways, so every category stays in view. */
  @container (max-width: 16rem) {
    .catalog-filter :global(.chip-group) {
      flex-wrap: wrap;
      overflow-x: visible;
      margin-inline: 0;
      padding-inline: 0;
    }
  }
</style>
