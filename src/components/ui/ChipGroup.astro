---
// Horizontally scrolling chip row (the reference lets the last chip run off the edge).
// The row bleeds to the viewport edge on small screens so the overflow reads as scrollable.

interface Props {
  label: string;
  bleed?: boolean;
}

const { label, bleed = true } = Astro.props;
---

<div class:list={["chip-group", bleed && "chip-group--bleed"]} role="group" aria-label={label}>
  <slot />
</div>

<style>
  .chip-group {
    display: flex;
    gap: var(--space-2);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
    padding-block: var(--space-1);
  }

  .chip-group::-webkit-scrollbar {
    display: none;
  }

  .chip-group > :global(*) {
    scroll-snap-align: start;
  }

  .chip-group--bleed {
    margin-inline: calc(var(--gutter) * -1);
    padding-inline: var(--gutter);
    scroll-padding-inline: var(--gutter);
  }
</style>
