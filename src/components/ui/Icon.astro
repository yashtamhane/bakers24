---
// Thin-line icons matching the approved reference (1.5px strokes, rounded ends).
// Decorative by default; pass `label` only when the icon is the sole content of a control
// that has no other accessible name (prefer labelling the control itself).

export type IconName = "arrow-right" | "arrow-left" | "search" | "menu" | "close" | "heart" | "whatsapp";

interface Props {
  name: IconName;
  size?: number;
  label?: string;
  class?: string;
}

const { name, size = 20, label, class: className } = Astro.props;

const paths: Record<IconName, string> = {
  "arrow-right": '<path d="M4 12h15"/><path d="m13.5 6.5 5.5 5.5-5.5 5.5"/>',
  "arrow-left": '<path d="M20 12H5"/><path d="m10.5 6.5-5.5 5.5 5.5 5.5"/>',
  search: '<circle cx="10.5" cy="10.5" r="7.25"/><path d="m15.75 15.75 5.25 5.25"/>',
  menu: '<path d="M3 5.5h18"/><path d="M3 12h18"/><path d="M3 18.5h18"/>',
  close: '<path d="m5.5 5.5 13 13"/><path d="m18.5 5.5-13 13"/>',
  heart:
    '<path d="M12 19.6s-7.25-4.35-7.25-9.6A4.05 4.05 0 0 1 8.8 5.9c1.35 0 2.5.66 3.2 1.75a3.82 3.82 0 0 1 3.2-1.75 4.05 4.05 0 0 1 4.05 4.1c0 5.25-7.25 9.6-7.25 9.6Z"/>',
  whatsapp:
    '<path d="M4.4 19.6 5.5 16a8 8 0 1 1 2.9 2.75Z"/><path d="M9.2 8.6c.2-.45.55-.5.85-.5h.4c.15 0 .35.05.45.3l.6 1.45c.05.15.05.3-.05.45l-.45.55c-.1.1-.15.3-.05.45a5.5 5.5 0 0 0 2.6 2.25c.15.05.3 0 .4-.1l.55-.65c.1-.15.3-.2.45-.1l1.4.65c.2.1.3.25.3.45 0 .55-.3 1.3-1.1 1.55-.9.3-2.1.1-3.6-.75a8 8 0 0 1-2.9-3.1c-.45-.85-.4-1.55-.25-2.05Z"/>',
};
---

<svg
  class:list={["icon", className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={label ? undefined : "true"}
  role={label ? "img" : undefined}
  aria-label={label}
  focusable="false"
  set:html={paths[name]}
/>

<style>
  .icon {
    flex: none;
  }
</style>
