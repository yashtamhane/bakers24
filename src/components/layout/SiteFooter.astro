---
// Quiet site footer (PAGE_BLUEPRINTS §1): the reference's closing line “A Little Cake / A Lot of
// Love”, the identity, where to find the shop, how to reach it, and the concept-demonstration
// notice CONTENT.md requires. Facts come from src/data/business.ts; unconfirmed details
// (hours, email, delivery, map pin) are intentionally absent.
//
// Composition: a centred signature (motto, champagne rule, logo, echoing the header's centred
// lockup) is the one display moment; the contact details sit below it as a quieter block; the
// disclosure closes the page behind a hairline. Tight spacing inside groups, generous between.

import Logo from "../brand/Logo.astro";
import { business, conceptNotice } from "../../data/business";
---

<footer class="site-footer">
  <div class="site-footer__signature">
    <p class="site-footer__motto">
      <span class="site-footer__motto-line">A Little Cake</span>
      <span class="site-footer__motto-line">A Lot of Love</span>
    </p>
    <span class="site-footer__rule" aria-hidden="true"></span>
    <Logo class="site-footer__logo" />
  </div>

  <address class="site-footer__contact">
    <div class="site-footer__group">
      <h2 class="t-eyebrow site-footer__heading">Visit</h2>
      <p class="site-footer__address">
        {business.address.lines.map((line) => <span class="site-footer__address-line">{line}</span>)}
      </p>
    </div>

    <div class="site-footer__group">
      <h2 class="t-eyebrow site-footer__heading">Say hello</h2>
      <ul class="site-footer__links" role="list">
        <li>
          <a class="site-footer__link" href={business.whatsapp.href}>
            <span class="site-footer__link-label">WhatsApp</span>
            <span class="site-footer__link-value">{business.whatsapp.display}</span>
          </a>
        </li>
        <li>
          <a class="site-footer__link" href={business.instagram.href}>
            <span class="site-footer__link-label">Instagram</span>
            <span class="site-footer__link-value">{business.instagram.handle}</span>
          </a>
        </li>
      </ul>
    </div>
  </address>

  <p class="site-footer__notice">{conceptNotice}</p>
</footer>

<style>
  .site-footer {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-12);
    padding: var(--space-10) var(--gutter) calc(var(--space-10) + env(safe-area-inset-bottom, 0px));
    text-align: center;
    /* Faint amber light behind the signature (kept clear of the top edge so it never seams with
       the ivory section's curve) and a black-cherry wash in the lower corner. */
    background:
      radial-gradient(70% 22% at 50% 30%, rgb(104 56 28 / 0.22), transparent 70%),
      radial-gradient(90% 40% at 100% 100%, rgb(81 30 41 / 0.45), transparent 70%),
      var(--color-bg);
    color: var(--color-text);
  }

  .site-footer__signature {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .site-footer__motto {
    display: flex;
    flex-direction: column;
    font-family: var(--font-display);
    font-size: 2rem;
    font-style: italic;
    line-height: 1.15;
    color: var(--color-text);
  }

  /* The reference's fine champagne rule, here linking the motto to the signature. */
  .site-footer__rule {
    width: 2.5rem;
    height: 1px;
    margin-block: var(--space-6);
    background: var(--palette-champagne-300);
    opacity: 0.8;
  }

  .site-footer__contact {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-8);
    width: 100%;
    font-style: normal;
  }

  .site-footer__heading {
    margin-bottom: var(--space-2);
  }

  .site-footer__address {
    color: var(--color-text-soft);
    font-size: var(--text-small);
    line-height: 1.6;
  }

  .site-footer__address-line {
    display: block;
  }

  .site-footer__links {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .site-footer__link {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: center;
    column-gap: var(--space-2);
    min-height: var(--tap-min);
    padding-block: var(--space-2);
    color: var(--color-text);
    font-size: var(--text-small);
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }

  .site-footer__link-label {
    color: var(--color-text-eyebrow);
  }

  .site-footer__link-value {
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--color-accent) 60%, transparent);
    text-underline-offset: 0.3em;
    overflow-wrap: anywhere;
    transition: text-decoration-color var(--duration-base) var(--ease-out);
  }

  .site-footer__link:hover .site-footer__link-value {
    text-decoration-color: var(--color-accent);
  }

  .site-footer__notice {
    width: 100%;
    max-width: 22rem;
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-hairline);
    color: var(--color-text-eyebrow);
    font-size: 0.8125rem;
    line-height: 1.5;
  }
</style>
