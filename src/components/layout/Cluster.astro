---
// Inline group that wraps: buttons, icon rows, metadata.

import type { HTMLTag } from "astro/types";

type Space = 1 | 2 | 3 | 4 | 5 | 6 | 8 | 10 | 12;

interface Props {
  as?: HTMLTag;
  gap?: Space;
  justify?: "start" | "center" | "end" | "space-between";
  align?: "start" | "center" | "end" | "baseline";
  class?: string;
}

const { as: Tag = "div", gap = 3, justify = "start", align = "center", class: className } = Astro.props;
---

<Tag
  class:list={["cluster", className]}
  style={`--cluster-gap: var(--space-${gap}); --cluster-justify: ${justify}; --cluster-align: ${align}`}
>
  <slot />
</Tag>

<style>
  .cluster {
    display: flex;
    flex-wrap: wrap;
    gap: var(--cluster-gap);
    justify-content: var(--cluster-justify);
    align-items: var(--cluster-align);
  }
</style>
