---
// Horizontal page frame: centred, capped width, responsive gutters.
//   default   mobile-first gutter (20–32px)
//   wide      desktop editorial inset (copy sits ~107px in at 1440, as in the reference)

import type { HTMLTag } from "astro/types";

interface Props {
  as?: HTMLTag;
  width?: "default" | "wide";
  class?: string;
}

const { as: Tag = "div", width = "default", class: className } = Astro.props;
---

<Tag class:list={["container", `container--${width}`, className]}>
  <slot />
</Tag>

<style>
  .container {
    width: 100%;
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .container--wide {
    padding-inline: var(--gutter-wide);
  }
</style>
